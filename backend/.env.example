# Copiar a .env y ajustar. Ver app/config.py para los valores por defecto.

# SQL Server en producción (ejemplo); SQLite en desarrollo local: sqlite:///./dev.db
DATABASE_URL=mssql+pyodbc://sa:TuPasswordSegura1@localhost:1433/ocr?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

API_KEY=cambiar-en-produccion

# Motor OCR principal: paddle (default) / doctr / tesseract (fallback ligero)
OCR_MOTOR=paddle
# Segunda opinión (validación cruzada en campos de baja confianza): doctr / ninguno
OCR_SEGUNDA_OPINION=doctr
OCR_UMBRAL_SEGUNDA_OPINION=0.7
OCR_IDIOMA=spa
OCR_DPI=300

ALMACEN_RUTA=./data/archivos
MAX_TAMANO_MB=20
UMBRAL_DESCONOCIDO=0.5

# Solo Windows / entornos sin el paquete tesseract-ocr en PATH:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=./tessdata

# Pasos de preprocesado (activables individualmente)
PRE_DESKEW=true
PRE_DENOISE=true
PRE_BINARIZAR=true
PRE_REESCALAR=true

# Crear tablas automáticamente al iniciar (solo pensado para SQLite en desarrollo;
# en SQL Server el esquema lo crea otro proceso con scripts SQL, nunca aquí)
CREAR_TABLAS=false

LOG_LEVEL=INFO

# Servidor MCP (mcp_server/server.py)
OCR_API_URL=http://localhost:8000/api
OCR_API_KEY=cambiar-en-produccion
MCP_TRANSPORT=stdio
