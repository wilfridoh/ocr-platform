# ---------------------------------------------------------------------------
# OCR Platform - variables de entorno (DESARROLLO LOCAL)
#
# Copiar a .env (scripts\levantar.ps1 lo hace automaticamente si no existe).
# .env NO se versiona. Cambiar TODAS las claves antes de ir a produccion.
# ---------------------------------------------------------------------------

# ---- SQL Server -----------------------------------------------------------
# Politica de SQL Server: >= 8 caracteres, con mayuscula, minuscula, digito y simbolo.
# Evitar @ : / ? # porque la contrasena se inserta sin codificar en DATABASE_URL.
MSSQL_SA_PASSWORD=Ocr_Dev_2026!
MSSQL_PID=Developer
MSSQL_COLLATION=Latin1_General_100_CI_AI_SC_UTF8
DB_NOMBRE=ocr
# Puerto del host para conectarse desde SSMS / Azure Data Studio.
# Si 1433 esta ocupado por otra instancia, cambiar a 14330 por ejemplo.
MSSQL_PUERTO_HOST=1433

# Cadena completa (opcional). Si se deja vacia, compose la arma con las variables
# de arriba apuntando al servicio interno "mssql". Util en nube (Azure SQL).
DATABASE_URL=

# ---- API backend ----------------------------------------------------------
API_KEY=clave-dev-cambiar
OCR_MOTOR=paddle
OCR_IDIOMA=spa
OCR_DPI=300
# Segunda opinion (docTR, ~13 s por pagina): true = un campo opcional vacio no la dispara por si solo (la disparan
# los obligatorios vacios o dudosos y cualquier campo con valor dudoso). false = cualquier campo bajo el umbral.
OCR_SEGUNDA_OPINION_SOLO_OBLIGATORIOS=true
ALMACEN_RUTA=/data/archivos
MAX_TAMANO_MB=20
UMBRAL_DESCONOCIDO=0.5
BACKEND_PUERTO_HOST=8000

# ---- Servidor MCP ---------------------------------------------------------
# Dentro del Compose el MCP usa http://backend:8000/api y la misma API_KEY.
# Estas dos variables son para correr el MCP por stdio desde el host (ver docs/05).
OCR_API_URL=http://localhost:8000/api
OCR_API_KEY=clave-dev-cambiar
MCP_PUERTO_HOST=8001

# ---- Frontend -------------------------------------------------------------
FRONTEND_PUERTO_HOST=3000

# ---- General --------------------------------------------------------------
TZ=America/Guayaquil
